# ============================================================
# AI-Based Smart Garbage Waste Segregator — Environment Variables
# ============================================================

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
DEBUG=True

# YOLO Model Configuration
# Available checkpoints: yolo11n_768_baseline, yolo11n_fresh_baseline, yolo11n_15class_target
ACTIVE_MODEL_ID=yolo11n_768_baseline
CONFIDENCE_THRESHOLD_DEFAULT=0.20
IOU_THRESHOLD_DEFAULT=0.45

# Hardware Acceleration (mps, cuda, cpu)
DEVICE_PREFERENCE=mps

# Storage Directories (Absolute or relative to backend/)
UPLOADS_DIR=uploads
RESULTS_DIR=results
DATABASE_PATH=database/waste_segregator.db

# Frontend API URL
REACT_APP_API_URL=http://localhost:5000

